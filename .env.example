# Resend (https://resend.com) — free tier covers this comfortably.
# Sign up, verify a sending domain (or use the no-setup onboarding@resend.dev
# sender while you test), then create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The address the reports are sent FROM. While testing, you can leave this as
# onboarding@resend.dev (works immediately, no domain setup). Once you verify
# your own domain in Resend, switch this to something like
# reports@tubalcainadsenterprise.com for a more trustworthy sender.
FROM_EMAIL=Tubalcain Ads Enterprise <onboarding@resend.dev>

# Every submitted lead's details (name, email, URL, relation to property)
# plus a copy of their report findings are sent here for your follow-up.
OWNER_EMAIL=tubalcain.my@gmail.com

# Shown in the report footer and the owner notification email.
OWNER_WHATSAPP=2348000000000
OWNER_PORTFOLIO_URL=https://tubalcainmy.github.io/alajayibomystery/

# Port the server listens on (Render sets this automatically — you usually
# don't need to touch this in production).
PORT=3000
